{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "check": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "fix": {
      "cache": false
    },
    "react:doctor": {},
    "typecheck": {}
  }
}
