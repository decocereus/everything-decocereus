{
  "name": "draw",
  "version": "0.1.0",
  "private": true,
  "description": "Private Excalidraw whiteboard that agents can draw on",
  "author": "decocereus",
  "type": "module",
  "scripts": {
    "build": "node scripts/copy-fonts.mjs && next build",
    "check": "ultracite check",
    "dev": "node scripts/copy-fonts.mjs && next dev --port 3002",
    "fix": "ultracite fix",
    "react:doctor": "react-doctor . --no-telemetry --no-supply-chain",
    "start": "next start --port 3002",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "~3.1.3",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^3.6.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@sparticuz/chromium-min": "153.0.0",
    "aws4fetch": "^1.0.20",
    "fractional-indexing": "^3.2.0",
    "mcp-handler": "^2.4.0",
    "next": "16.3.0",
    "puppeteer-core": "25.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "baseline-browser-mapping": "2.11.13",
    "react-doctor": "0.9.11",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
